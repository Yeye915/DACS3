<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarChat"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/background"
        app:title="Trợ lý House"
        app:subtitle="Cùng bạn chăm sóc tổ ấm"
        app:titleTextColor="@color/text_primary"
        app:subtitleTextColor="@color/text_secondary"
        app:navigationIcon="@drawable/ic_ui_back" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarChat"
        android:layout_above="@id/layoutInput"
        android:padding="16dp"
        android:clipToPadding="false" />
    <LinearLayout
        android:id="@+id/welcomeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarChat"
        android:layout_above="@id/layoutInput"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="18dp"
            android:src="@drawable/ic_ui_chat"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/chat_welcome_title"
            android:textAppearance="@style/TextAppearance.House.Section" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/chat_welcome_body"
            android:textAppearance="@style/TextAppearance.House.Body" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuggestRoom"
            style="@style/Widget.House.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/chat_suggestion_room"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuggestContract"
            style="@style/Widget.House.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/chat_suggestion_contract"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="@string/chat_hint"
            android:background="@drawable/bg_input_field" />
        <ImageButton
            android:id="@+id/btnSend"
            style="@style/Widget.House.IconButton"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_ui_send"
            android:contentDescription="@string/action_send" />
    </LinearLayout>
</RelativeLayout>
