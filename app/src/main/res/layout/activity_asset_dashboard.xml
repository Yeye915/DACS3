<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:id="@+id/topBarAsset"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="0dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ui_back"
            app:tint="@color/text_primary"
            android:padding="12dp"
            android:contentDescription="@string/action_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Tài sản của bạn"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchAssetCard"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_below="@id/topBarAsset"
        android:layout_margin="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        style="@style/Widget.House.Card"
        app:cardBackgroundColor="@color/surface">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_ui_search"
                app:tint="@color/itro_green" />
            <EditText
                android:id="@+id/edtSearchAsset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Tìm nhanh tài sản (vđ: Điều hòa, Giường...)"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAssets"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchAssetCard"
        android:padding="6dp"
        android:clipToPadding="false" />
    <TextView
        android:id="@+id/tvEmptyAsset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Chưa có dữ liệu tài sản nào"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        android:padding="28dp"
        android:gravity="center"
        android:drawableTop="@drawable/illustration_home"
        android:drawablePadding="16dp"
        android:accessibilityLiveRegion="polite" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddAsset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:src="@drawable/ic_ui_plus"
        app:backgroundTint="@color/primary"
        app:tint="@color/on_primary"
        android:contentDescription="@string/action_add" />
</RelativeLayout>
