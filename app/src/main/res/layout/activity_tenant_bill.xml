<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:id="@+id/topBarBill"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="0dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ui_back"
            app:tint="@color/text_primary"
            android:padding="12dp"
            android:contentDescription="@string/action_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Hóa Đơn Của Tôi"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTenantBills"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarBill"
        android:padding="12dp"
        android:clipToPadding="false" />
    <TextView
        android:id="@+id/tvEmptyBill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Bạn chưa có hóa đơn tiền phòng nào!"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        android:padding="28dp"
        android:gravity="center"
        android:drawableTop="@drawable/illustration_home"
        android:drawablePadding="16dp"
        android:accessibilityLiveRegion="polite" />
</RelativeLayout>
